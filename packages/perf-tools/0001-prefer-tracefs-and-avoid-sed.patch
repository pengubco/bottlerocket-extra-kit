+if ! grep "^$tpoint\$" $tracing/available_events > /dev/null
 then
 	echo >&2 "ERROR: tracepoint \"$tpoint\" not found. Exiting..."
 	[[ "$USER" != "root" ]] && echo >&2 "Not root user?"
